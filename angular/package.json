{
  "name": "pakdatakit-angular",
  "version": "0.1.1",
  "description": "Angular directives, pipes, form validators and ready-made checkout and KYC forms for Pakistani CNIC, mobile numbers, IBANs, addresses and more, built on pakdatakit",
  "keywords": [
    "pakistan",
    "angular",
    "cnic",
    "phone",
    "mobile",
    "iban",
    "input",
    "input-mask",
    "form",
    "validators",
    "pipes",
    "directive",
    "pakdatakit",
    "address",
    "checkout",
    "kyc",
    "urdu",
    "reactive-forms"
  ],
  "author": "Muzamil Chaudhery",
  "license": "MIT",
  "homepage": "https://pakdatakit.dev/install/angular/",
  "bugs": {
    "url": "https://github.com/chmuzamil/pakdatakit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chmuzamil/pakdatakit.git",
    "directory": "angular"
  },
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
