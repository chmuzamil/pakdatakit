<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>PakDataKit.FluentValidation</PackageId>
    <RootNamespace>PakDataKit.FluentValidation</RootNamespace>
    <Description>FluentValidation rules for Pakistani identifiers, built on PakDataKit: IsCnic(), IsPakPhone(), IsPakIban(), IsNtn(), IsStrn(), IsPakLandline(), IsPakPassport() and IsVehiclePlate().</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageTags>$(PackageTags);fluentvalidation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="[11.0.0,13.0.0)" />
    <ProjectReference Include="..\PakDataKit\PakDataKit.csproj" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
