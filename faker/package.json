{
  "name": "pakdatakit-faker",
  "version": "0.1.0",
  "description": "Seeded mock data for Pakistan: valid CNICs, mobile numbers, landlines, IBANs, NTNs, names, addresses, companies and coherent personas, checked against pakdatakit",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --config ../.prettierrc --write src tests README.md *.ts *.js",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "pakistan",
    "faker",
    "mock",
    "fake",
    "test-data",
    "seed",
    "fixtures",
    "cnic",
    "phone",
    "iban",
    "ntn",
    "address",
    "pakdatakit"
  ],
  "author": "Muzamil Chaudhery",
  "license": "MIT",
  "homepage": "https://github.com/chmuzamil/pakdatakit/tree/main/faker#readme",
  "bugs": {
    "url": "https://github.com/chmuzamil/pakdatakit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chmuzamil/pakdatakit.git",
    "directory": "faker"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pakdatakit": "^2.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "pakdatakit": "file:..",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
