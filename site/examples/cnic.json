{
  "module": "cnic",
  "title": "CNIC",
  "examples": [
    {
      "id": "validate",
      "title": "Validate a CNIC",
      "fn": "validateCNIC",
      "args": ["35202-1234567-1"],
      "expected": true
    },
    {
      "id": "validate-bad",
      "title": "An invalid province code",
      "fn": "validateCNIC",
      "args": ["05202-1234567-1"],
      "expected": false
    },
    {
      "id": "info",
      "title": "Province and gender",
      "fn": "getCNICInfo",
      "args": ["35202-1234567-1"],
      "expected": {
        "digits": "3520212345671",
        "formatted": "35202-1234567-1",
        "province": "Punjab",
        "gender": "male"
      }
    },
    {
      "id": "find",
      "title": "Find CNICs in free text",
      "fn": "findCNICs",
      "args": ["CNIC: 35202-1234567-1, phone 0300-1234567"],
      "expected": [
        {
          "raw": "35202-1234567-1",
          "digits": "3520212345671",
          "formatted": "35202-1234567-1",
          "start": 6,
          "end": 21
        }
      ]
    },
    {
      "id": "mask",
      "title": "Mask them before logging",
      "fn": "maskCNICs",
      "args": ["My CNIC is 35202 1234567-1"],
      "expected": {
        "text": "My CNIC is XXXXX XXXXXXX-X",
        "count": 1
      }
    }
  ]
}
