{
  "module": "incometax",
  "title": "Income tax on salary",
  "examples": [
    {
      "id": "annual",
      "title": "Tax on Rs. 5,000,000 a year (tax year 2027)",
      "fn": "calculateSalaryTax",
      "args": [
        5000000
      ],
      "kwargs": {
        "taxYear": 2027
      },
      "expected": {
        "tax": 802000,
        "surcharge": 0,
        "total": 802000,
        "monthly": 66833.33,
        "effectiveRate": 16.04,
        "slab": {
          "over": 4100000,
          "upTo": 5600000,
          "fixed": 541000,
          "rate": 29
        },
        "taxYear": 2027,
        "source": {
          "id": "income-tax-slabs",
          "effectiveFrom": "2026-07-01",
          "effectiveTo": "2027-06-30",
          "sourceReference": "Income Tax Ordinance 2001, First Schedule, Part I, Division I, clause (2), as substituted by the Finance Act 2026",
          "sourceUrl": "https://download1.fbr.gov.pk/Docs/20266291261044366FinanceAct2026.pdf"
        }
      }
    },
    {
      "id": "monthly",
      "title": "Tax on Rs. 150,000 a month (tax year 2027)",
      "fn": "calculateMonthlySalaryTax",
      "args": [
        150000
      ],
      "kwargs": {
        "taxYear": 2027
      },
      "expected": {
        "tax": 72000,
        "surcharge": 0,
        "total": 72000,
        "monthly": 6000,
        "effectiveRate": 4,
        "slab": {
          "over": 1200000,
          "upTo": 2200000,
          "fixed": 6000,
          "rate": 11
        },
        "taxYear": 2027,
        "source": {
          "id": "income-tax-slabs",
          "effectiveFrom": "2026-07-01",
          "effectiveTo": "2027-06-30",
          "sourceReference": "Income Tax Ordinance 2001, First Schedule, Part I, Division I, clause (2), as substituted by the Finance Act 2026",
          "sourceUrl": "https://download1.fbr.gov.pk/Docs/20266291261044366FinanceAct2026.pdf"
        }
      }
    },
    {
      "id": "year",
      "title": "Tax year of a date",
      "fn": "getTaxYear",
      "args": [
        "2026-11-18"
      ],
      "expected": 2027
    },
    {
      "id": "surcharge",
      "title": "With the surcharge (tax year 2026, Rs. 12 million)",
      "fn": "calculateSalaryTax",
      "args": [
        12000000
      ],
      "kwargs": {
        "taxYear": 2026,
        "includeSurcharge": true
      },
      "expected": {
        "tax": 3381000,
        "surcharge": 304290,
        "total": 3685290,
        "monthly": 307107.5,
        "effectiveRate": 30.71,
        "slab": {
          "over": 4100000,
          "upTo": null,
          "fixed": 616000,
          "rate": 35
        },
        "taxYear": 2026,
        "source": {
          "id": "income-tax-slabs",
          "effectiveFrom": "2025-07-01",
          "effectiveTo": "2026-06-30",
          "sourceReference": "Income Tax Ordinance 2001, First Schedule, Part I, Division I, clause (2), as substituted by the Finance Act 2025",
          "sourceUrl": "https://download1.fbr.gov.pk/Docs/2025881983148210Income-Tax-Ordinance,-2001-Amended-upto-31.07.2025.pdf"
        }
      }
    }
  ]
}
