{
  "module": "numbers",
  "title": "Numbers",
  "examples": [
    {
      "id": "landline",
      "title": "Analyze a landline",
      "fn": "analyzeNumber",
      "args": ["042 35761234"],
      "expected": {
        "type": "landline",
        "formatted": "042-35761234",
        "e164": "+924235761234",
        "areaCode": "042",
        "cities": ["Lahore"]
      }
    },
    {
      "id": "type",
      "title": "Type of a UAN",
      "fn": "getNumberType",
      "args": ["021-111-123-456"],
      "expected": "uan"
    },
    {
      "id": "validate",
      "title": "Validate a landline",
      "fn": "validateLandline",
      "args": ["051-2345678"],
      "expected": true
    },
    {
      "id": "area-code",
      "title": "Area code for a city",
      "fn": "getAreaCode",
      "args": ["Faisalabad"],
      "expected": "041"
    },
    {
      "id": "services",
      "title": "Accept UAN, toll-free and premium numbers too",
      "fn": "validateLandline",
      "args": ["021-111-123-456"],
      "kwargs": {
        "services": true
      },
      "expected": true
    },
    {
      "id": "toll-free",
      "title": "A toll-free number: 0800 and five digits",
      "fn": "analyzeNumber",
      "args": ["0800-78686"],
      "expected": {
        "type": "toll-free",
        "formatted": "0800-78686",
        "e164": "+9280078686",
        "areaCode": null,
        "cities": []
      }
    }
  ]
}
