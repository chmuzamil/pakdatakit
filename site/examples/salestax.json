{
  "module": "salestax",
  "title": "Sales tax",
  "examples": [
    {
      "id": "rate",
      "title": "Punjab services rate on a date",
      "fn": "getSalesTaxRate",
      "args": [],
      "kwargs": {
        "kind": "services",
        "province": "Punjab",
        "date": "2026-11-18"
      },
      "expected": {
        "kind": "services",
        "authority": "PRA",
        "province": "Punjab",
        "rate": 16,
        "from": "2019-07-01",
        "to": null,
        "law": "Punjab Sales Tax on Services Act 2012, s. 2(41A) and Second Schedule",
        "source": "https://pra.punjab.gov.pk/Downloads/THE-PUNJAB-SALES-TAX-ON-SERVICES-ACT-2012-17th-Edition-2026-2027.pdf"
      }
    },
    {
      "id": "calculate",
      "title": "Sales tax on Rs. 1,000 of goods",
      "fn": "calculateSalesTax",
      "args": [
        1000
      ],
      "kwargs": {
        "kind": "goods",
        "date": "2026-11-18"
      },
      "expected": {
        "net": 1000,
        "tax": 180,
        "gross": 1180,
        "rate": 18,
        "source": {
          "id": "sales-tax-rates",
          "effectiveFrom": "2023-02-23",
          "effectiveTo": null,
          "sourceReference": "Sales Tax Act 1990, s. 3(1), as amended by the Finance (Supplementary) Act 2023",
          "sourceUrl": "https://download1.fbr.gov.pk/Docs/20267171373418951SalesTaxAct1990updatedupto30.06.2026.pdf"
        }
      }
    },
    {
      "id": "inclusive",
      "title": "Split a tax-inclusive amount",
      "fn": "calculateSalesTax",
      "args": [
        1150
      ],
      "kwargs": {
        "province": "Sindh",
        "kind": "services",
        "date": "2026-11-18",
        "inclusive": true
      },
      "expected": {
        "net": 1000,
        "tax": 150,
        "gross": 1150,
        "rate": 15,
        "source": {
          "id": "sales-tax-rates",
          "effectiveFrom": "2024-07-01",
          "effectiveTo": null,
          "sourceReference": "Sindh Sales Tax on Services Act 2011, s. 8(1), as amended by the Sindh Finance Acts 2024 and 2025",
          "sourceUrl": "https://www.srb.gos.pk/srb/wp-content/uploads/2026/01/Sindh-Sales-Tax-Act-2011-25-26-2.pdf"
        }
      }
    },
    {
      "id": "split",
      "title": "Split at a given rate",
      "fn": "splitInclusive",
      "args": [
        1180,
        18
      ],
      "expected": {
        "net": 1000,
        "tax": 180,
        "gross": 1180,
        "rate": 18
      }
    }
  ]
}
