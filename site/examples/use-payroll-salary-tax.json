{
  "module": "use-payroll-salary-tax",
  "title": "Payroll and salary tax",
  "examples": [
    {
      "id": "typed",
      "title": "Read a salary as HR types it",
      "fn": "parseAmount",
      "args": [
        "1.5 lakh"
      ],
      "expected": {
        "value": 150000,
        "raw": "1.5 lakh"
      }
    },
    {
      "id": "typed-grouped",
      "title": "Or with lakh grouping and a currency mark",
      "fn": "parseAmount",
      "args": [
        "Rs. 2,50,000/-"
      ],
      "expected": {
        "value": 250000,
        "raw": "Rs. 2,50,000/-"
      }
    },
    {
      "id": "typed-bad",
      "title": "A range is not one salary",
      "fn": "parseAmount",
      "args": [
        "1-1.5 lakh"
      ],
      "expected": null
    },
    {
      "id": "year",
      "title": "The tax year of the payroll month",
      "fn": "getTaxYear",
      "args": [
        "2026-11-20"
      ],
      "expected": 2027
    },
    {
      "id": "monthly",
      "title": "Tax on Rs. 150,000 a month",
      "fn": "calculateMonthlySalaryTax",
      "args": [
        150000
      ],
      "kwargs": {
        "taxYear": 2027
      },
      "expected": {
        "tax": 72000,
        "surcharge": 0,
        "total": 72000,
        "monthly": 6000,
        "effectiveRate": 4,
        "slab": {
          "over": 1200000,
          "upTo": 2200000,
          "fixed": 6000,
          "rate": 11
        },
        "taxYear": 2027,
        "source": {
          "id": "income-tax-slabs",
          "effectiveFrom": "2026-07-01",
          "effectiveTo": "2027-06-30",
          "sourceReference": "Income Tax Ordinance 2001, First Schedule, Part I, Division I, clause (2), as substituted by the Finance Act 2026",
          "sourceUrl": "https://download1.fbr.gov.pk/Docs/20266291261044366FinanceAct2026.pdf"
        }
      }
    },
    {
      "id": "payslip",
      "title": "The amount on the payslip",
      "fn": "formatPKR",
      "args": [
        144000
      ],
      "expected": "Rs. 144,000"
    },
    {
      "id": "words",
      "title": "In words, for a cheque or letter",
      "fn": "amountInWords",
      "args": [
        144000
      ],
      "expected": "one lakh forty-four thousand rupees"
    },
    {
      "id": "surcharge",
      "title": "Above Rs. 10 million, with the surcharge (tax year 2026)",
      "fn": "calculateMonthlySalaryTax",
      "args": [
        1000000
      ],
      "kwargs": {
        "taxYear": 2026,
        "includeSurcharge": true
      },
      "expected": {
        "tax": 3381000,
        "surcharge": 304290,
        "total": 3685290,
        "monthly": 307107.5,
        "effectiveRate": 30.71,
        "slab": {
          "over": 4100000,
          "upTo": null,
          "fixed": 616000,
          "rate": 35
        },
        "taxYear": 2026,
        "source": {
          "id": "income-tax-slabs",
          "effectiveFrom": "2025-07-01",
          "effectiveTo": "2026-06-30",
          "sourceReference": "Income Tax Ordinance 2001, First Schedule, Part I, Division I, clause (2), as substituted by the Finance Act 2025",
          "sourceUrl": "https://download1.fbr.gov.pk/Docs/2025881983148210Income-Tax-Ordinance,-2001-Amended-upto-31.07.2025.pdf"
        }
      }
    }
  ]
}
