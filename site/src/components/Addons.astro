---
/**
 * The add-on packages, one line each: the name (never broken across lines)
 * links to the install guide, or to npm for packages without one, then
 * what it's for.
 */
const ADDONS = [
  { name: 'pakdatakit-react', purpose: 'React inputs, hooks and ready-made checkout and KYC forms.', href: '/install/react/' },
  { name: 'pakdatakit-vue', purpose: 'Vue composables, a directive and checkout and KYC forms.', href: '/install/vue/' },
  { name: 'pakdatakit-angular', purpose: 'Angular directives, pipes, validators and forms.', href: '/install/angular/' },
  { name: 'pakdatakit_flutter', purpose: 'Flutter fields that format as you type, validators and forms.', href: '/install/flutter/' },
  {
    name: 'pakdatakit-faker',
    purpose: 'Seeded mock data: valid CNICs, phones, IBANs, names and addresses.',
    href: 'https://www.npmjs.com/package/pakdatakit-faker',
  },
  {
    name: 'pakdatakit-pay',
    purpose: 'JazzCash secure hash: build and verify it, server-side.',
    href: 'https://www.npmjs.com/package/pakdatakit-pay',
  },
];
---

<ul class="pdk-addons not-content">
  {
    ADDONS.map((a) => (
      <li>
        <a href={a.href} class="pdk-addon-name">
          <code>{a.name}</code>
        </a>
        <span class="pdk-addon-purpose">{a.purpose}</span>
      </li>
    ))
  }
</ul>
