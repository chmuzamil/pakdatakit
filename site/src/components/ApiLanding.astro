---
/**
 * Landing page of an API reference (/api/typescript/, /api/python/, ...):
 * the modules grouped by topic, as cards with a short description, the
 * import path and what each module exports. The lead text and hint go in the
 * default slot.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';

export interface ApiCard {
  href: string;
  title: string;
  /** Import path or main type names. */
  path: string;
  description: string;
  counts: string;
}

export interface ApiGroup {
  title: string;
  intro: string;
  cards: ApiCard[];
}

interface Props {
  title: string;
  description: string;
  groups: ApiGroup[];
  example: { code: string; lang: string };
}

const { title, description, groups, example } = Astro.props;
---

<StarlightPage frontmatter={{ title, description, tableOfContents: false }}>
  <slot />

  <Code code={example.code} lang={example.lang} title="Quick start" />

  <slot name="hint" />

  {
    groups.map((group) => (
      <section class="api-group">
        <h2 id={group.title.toLowerCase().replace(/[^a-z]+/g, '-')}>{group.title}</h2>
        <p class="api-intro">{group.intro}</p>
        <ul class="api-grid not-content" role="list">
          {group.cards.map((m) => (
            <li>
              <a class="api-card" href={m.href}>
                <span class="api-title">{m.title}</span>
                <code class="api-path">{m.path}</code>
                <span class="api-desc">{m.description}</span>
                <span class="api-counts">{m.counts}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</StarlightPage>

<style>
  :global(.api-lead) {
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-2);
  }
  :global(.api-hint) {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  :global(.api-hint kbd) {
    font-family: var(--sl-font-mono);
    font-size: 0.8em;
    border: 1px solid var(--sl-color-gray-5);
    border-bottom-width: 2px;
    border-radius: var(--pdk-radius-sm);
    padding: 0 0.35em;
  }
  .api-group {
    margin-top: 2.5rem;
  }
  .api-intro {
    color: var(--sl-color-gray-3);
  }
  .api-grid {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }
  .api-card {
    display: grid;
    gap: 0.3rem;
    height: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--pdk-radius-card);
    background: var(--pdk-surface);
    color: var(--sl-color-gray-2);
    text-decoration: none;
  }
  .api-card:hover {
    border-color: var(--sl-color-accent);
  }
  .api-card:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .api-title {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .api-path {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-accent-high);
    background: none;
    padding: 0;
    border: 0;
    overflow-wrap: anywhere;
  }
  :global(:root[data-theme='light']) .api-path {
    color: var(--sl-color-accent);
  }
  .api-desc {
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }
  .api-counts {
    margin-top: 0.25rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .api-card:hover {
    box-shadow: 0 8px 24px -16px color-mix(in srgb, var(--sl-color-accent) 60%, transparent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .api-card {
      transition:
        border-color 0.2s,
        box-shadow 0.2s,
        transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .api-card:hover {
      transform: translateY(-2px);
    }
    .api-card:active {
      transform: translateY(0) scale(0.99);
    }
  }
</style>
