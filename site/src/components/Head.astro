---
/**
 * Starlight's <head>, plus:
 * - /lang.js: `?lang=` picks the code-tab language before the tabs restore it
 * - the Open Graph image (/og.png, the repo's banner.png) on every page
 * - Umami, served from this site's own origin (/a.js), path and tool name only
 */
import Default from '@astrojs/starlight/components/Head.astro';
import { version } from 'pakdatakit/package.json' with { type: 'json' };
import { dataVersion } from 'pakdatakit';
import { SITE, UMAMI_WEBSITE_ID } from '../../site.config.mjs';
import { structuredData } from '../lib/seo';

const route = Astro.locals.starlightRoute;
const id = route.id || 'index';
const ogImage = new URL('/og.png', SITE).href;
const is404 = Astro.url.pathname === '/404/' || Astro.url.pathname === '/404.html' || id === '404';
const jsonLd = is404
  ? null
  : structuredData({
      path: Astro.url.pathname,
      title: route.entry.data.title,
      // the page's own description, or the site's (as in the meta tag)
      description: String(
        route.head.find((t) => t.attrs?.name === 'description')?.attrs?.content ?? '',
      ),
      dataVersion,
      version,
    });
---

<Default />
<link rel="preload" href="/fonts/pdk-serif-600.woff2" as="font" type="font/woff2" crossorigin />
{jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
<script is:inline src="/lang.js"></script>
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1600" />
<meta property="og:image:height" content="800" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<script
  is:inline
  defer
  src="/a.js"
  data-website-id={UMAMI_WEBSITE_ID}
  data-exclude-search="true"
  data-exclude-hash="true"
  data-do-not-track="true"></script>
