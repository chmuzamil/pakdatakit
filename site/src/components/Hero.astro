---
/**
 * The home page's hero, left-aligned: the headline, one sentence, the
 * install command (language pills) and a link to the docs; the live demo
 * (CNIC or IBAN, code in the chosen language) on a glass panel on the right
 * from 50rem, below on smaller screens. Other splash pages (404) keep
 * Starlight's hero.
 */
import Default from '@astrojs/starlight/components/Hero.astro';
import HeroDemo from './widgets/HeroDemo.tsx';
import InstallSwitcher from './InstallSwitcher.astro';

// Starlight's id for the page title (skip links point at it).
const PAGE_TITLE_ID = '_top';
const isHome = Astro.locals.starlightRoute.id === '' || Astro.locals.starlightRoute.id === 'index';
---

{
  isHome ? (
    <div class="pdk-hero">
      <div class="pdk-hero-copy">
        <h1 id={PAGE_TITLE_ID} data-page-title>
          Validate a CNIC, IBAN or Raast QR the same way in five languages.
        </h1>
        <p class="pdk-hero-intro">
          One library for Pakistani identifiers, tax and addresses, with the same answer in every language. It runs
          offline.
        </p>
        <InstallSwitcher />
        <a class="pdk-hero-docs" href="/docs/">
          Read the docs
        </a>
      </div>
      <div class="pdk-hero-demo">
        <HeroDemo client:idle />
      </div>
    </div>
  ) : (
    <Default />
  )
}
