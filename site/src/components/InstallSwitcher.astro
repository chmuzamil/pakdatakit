---
/**
 * Install command per language: language pills (tabs), the command and a
 * copy button. Plain HTML plus a small script (no framework): the first tab
 * works without JS.
 */
const LANGS = [
  { id: 'ts', label: 'TypeScript', command: 'npm install pakdatakit', href: '/install/typescript/' },
  { id: 'py', label: 'Python', command: 'pip install pakdatakit', href: '/install/python/' },
  { id: 'dart', label: 'Dart', command: 'dart pub add pakdatakit', href: '/install/dart/' },
  { id: 'cs', label: 'C#', command: 'dotnet add package PakDataKit', href: '/install/dotnet/' },
  { id: 'php', label: 'PHP', command: 'composer require chmuzamil/pakdatakit', href: '/install/php/' },
];
---

<pdk-install class="pdk-install not-content">
  <div class="pdk-pills" role="tablist" aria-label="Install for">
    {
      LANGS.map((l, i) => (
        <button
          type="button"
          role="tab"
          class="pdk-pill"
          id={`install-tab-${l.id}`}
          aria-controls={`install-panel-${l.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          {l.label}
        </button>
      ))
    }
  </div>
  {
    LANGS.map((l, i) => (
      <div
        class="pdk-install-panel"
        role="tabpanel"
        id={`install-panel-${l.id}`}
        aria-labelledby={`install-tab-${l.id}`}
        hidden={i !== 0}
      >
        <div class="pdk-install-line">
          <code>{l.command}</code>
          <button type="button" class="pdk-install-copy" data-command={l.command}>
            Copy
          </button>
        </div>
        <a class="pdk-install-guide" href={l.href}>
          {l.label} install guide
        </a>
      </div>
    ))
  }
  <span class="sr-only" role="status" aria-live="polite"></span>
</pdk-install>

<script>
  class PdkInstall extends HTMLElement {
    connectedCallback() {
      const tabs = [...this.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const panels = [...this.querySelectorAll<HTMLElement>('[role="tabpanel"]')];
      const status = this.querySelector<HTMLElement>('[role="status"]');
      const select = (i: number, focus = false) => {
        tabs.forEach((t, j) => {
          t.setAttribute('aria-selected', String(i === j));
          t.tabIndex = i === j ? 0 : -1;
          panels[j].hidden = i !== j;
        });
        if (focus) tabs[i].focus();
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(i));
        t.addEventListener('keydown', (e) => {
          const n = tabs.length;
          const to =
            e.key === 'ArrowRight' ? (i + 1) % n : e.key === 'ArrowLeft' ? (i - 1 + n) % n : e.key === 'Home' ? 0 : e.key === 'End' ? n - 1 : -1;
          if (to < 0) return;
          e.preventDefault();
          select(to, true);
        });
      });
      let timer: number | undefined;
      for (const b of this.querySelectorAll<HTMLButtonElement>('.pdk-install-copy')) {
        b.addEventListener('click', async () => {
          let ok = true;
          try {
            await navigator.clipboard.writeText(b.dataset.command ?? '');
          } catch {
            ok = false;
          }
          b.textContent = ok ? 'Copied' : 'Select it';
          if (status) status.textContent = ok ? 'Install command copied' : 'Could not copy; select the command instead';
          clearTimeout(timer);
          timer = window.setTimeout(() => {
            b.textContent = 'Copy';
            if (status) status.textContent = '';
          }, 1600);
        });
      }
    }
  }
  customElements.define('pdk-install', PdkInstall);
</script>
