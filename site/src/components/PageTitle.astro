---
/**
 * Starlight's page title, plus:
 * - breadcrumbs (the same trail as the BreadcrumbList in the page's JSON-LD)
 * - "View as Markdown" and "Copy page" on pages that have a Markdown copy
 *   (src/pages/[...slug].md.ts)
 */
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { getCollection } from 'astro:content';
import { breadcrumbs } from '../lib/seo';

const route = Astro.locals.starlightRoute;
const crumbs = breadcrumbs(Astro.url.pathname, route.entry.data.title);
// The pages that have a Markdown copy: exactly the docs-collection entries
// that src/pages/[...slug].md.ts writes (custom pages such as tools and the
// playground have none), and only when this URL is that entry's own page.
const withMarkdown = new Set(
  (await getCollection('docs', (e) => !!e.body && !['index', '404'].includes(e.id))).map((e) => e.id),
);
const path = Astro.url.pathname.replace(/^\/|\/$/g, '');
const markdown = withMarkdown.has(path) ? `/${path}.md` : null;
---

{
  crumbs.length > 2 && (
    <nav aria-label="Breadcrumbs" class="pdk-breadcrumbs">
      <ol>
        {crumbs.slice(0, -1).map((c) => (
          <li>
            <a href={c.url}>{c.name}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
<Default />
{
  markdown && (
    <div class="pdk-page-actions" role="group" aria-label="This page as Markdown">
      <a class="pdk-page-action" href={markdown} type="text/markdown">
        View as Markdown
      </a>
      <button type="button" class="pdk-page-action pdk-copy-page" data-src={markdown}>
        Copy page
      </button>
    </div>
    <span class="sr-only pdk-page-status" role="status" aria-live="polite" />
  )
}

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.pdk-copy-page')) {
    const status = document.querySelector<HTMLElement>('.pdk-page-status');
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      let message: string;
      try {
        const res = await fetch(button.dataset.src ?? '');
        if (!res.ok) throw new Error(String(res.status));
        await navigator.clipboard.writeText(await res.text());
        message = 'Copied';
      } catch {
        message = 'Could not copy';
      }
      button.textContent = message;
      if (status) status.textContent = message === 'Copied' ? 'Page copied as Markdown' : 'Could not copy the page';
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.textContent = 'Copy page';
        if (status) status.textContent = '';
      }, 1800);
    });
  }
</script>

<style>
  .pdk-breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
    margin: 0 0 0.5rem;
    padding: 0;
    list-style: none;
    font-size: var(--sl-text-sm);
  }
  .pdk-breadcrumbs li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .pdk-breadcrumbs li + li::before {
    content: '/';
    color: var(--sl-color-gray-4);
  }
  .pdk-breadcrumbs a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .pdk-breadcrumbs a:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
  }
  /* Two small matching buttons, joined into one group. */
  .pdk-page-actions {
    display: inline-flex;
    margin-top: 0.75rem;
  }
  .pdk-page-action {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    border: 1px solid var(--sl-color-gray-5);
    background: transparent;
    padding: 0 0.75rem;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-sm);
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 0.15s,
      color 0.15s,
      background-color 0.15s;
  }
  .pdk-page-action:first-child {
    border-radius: 0.375rem 0 0 0.375rem;
  }
  .pdk-page-action:last-child {
    border-radius: 0 0.375rem 0.375rem 0;
    margin-inline-start: -1px;
  }
  .pdk-page-action:hover {
    position: relative;
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
  }
  .pdk-page-action:focus-visible {
    position: relative;
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  @media (pointer: coarse) {
    .pdk-page-action {
      min-height: 2.75rem;
    }
  }
</style>
