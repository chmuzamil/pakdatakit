---
/**
 * Call to action for raast-qr.com, the no-code printable Raast QR generator.
 * Used at the top of the Raast docs and the Raast collection use case.
 */
import CtaCard from './CtaCard.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Need a QR to print or share?',
  description = "Make one at raast-qr.com, with your bank's name and a download. No code needed.",
} = Astro.props;

// A decorative QR-like glyph: three finder squares and a few modules.
const modules = [
  [9, 1], [11, 1], [9, 3], [10, 4], [12, 3], [1, 9], [3, 9], [4, 11], [2, 12],
  [9, 9], [11, 9], [10, 10], [12, 11], [9, 12], [11, 12], [13, 13], [13, 9], [6, 9], [9, 6],
];
---

<CtaCard
  title={title}
  description={description}
  href="https://raast-qr.com/"
  button="Open raast-qr.com"
  label="Printable Raast QR"
>
  <svg class="pdk-cta-glyph" viewBox="0 0 15 15" aria-hidden="true" focusable="false">
    {[[0, 0], [8, 0], [0, 8]].map(([x, y]) => (
      <g>
        <rect x={x + 0.5} y={y + 0.5} width="6" height="6" rx="1" fill="none" stroke="currentColor" />
        <rect x={x + 2} y={y + 2} width="3" height="3" rx="0.5" fill="currentColor" />
      </g>
    ))}
    {modules.map(([x, y]) => <rect x={x} y={y} width="1" height="1" fill="currentColor" />)}
  </svg>
</CtaCard>
