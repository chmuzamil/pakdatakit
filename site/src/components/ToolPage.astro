---
/** Layout for a /tools/ page: Starlight chrome plus WebApplication structured data. */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { SITE } from '../../site.config.mjs';
import LangTabs from './LangTabs.astro';

interface Props {
  title: string;
  description: string;
  /** Short name for structured data, e.g. "CNIC format checker". */
  appName: string;
  path: string;
  /**
   * The code behind the tool, in five languages: examples from
   * site/examples/<module>.json (all of them, or the ids given).
   */
  code: { module: string; ids?: string[] }[];
  /** The guide for the module, e.g. "/docs/phone/". */
  guide: string;
}

const { title, description, appName, path, code, guide } = Astro.props;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: appName,
  url: new URL(path, SITE).href,
  description,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any (runs in the browser)',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'PKR' },
  publisher: { '@type': 'Organization', name: 'PakDataKit', url: SITE },
};
---

<StarlightPage frontmatter={{ title, description, tableOfContents: false }}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <slot />
  <details class="pdk-card pdk-code">
    <summary>Code: do this in your app</summary>
    <p>
      The same checks with PakDataKit, in TypeScript, Python, Dart, C# and PHP.
      More in the <a href={guide}>guide</a>.
    </p>
    {code.map(({ module, ids }) => <LangTabs module={module} ids={ids} />)}
  </details>
</StarlightPage>
