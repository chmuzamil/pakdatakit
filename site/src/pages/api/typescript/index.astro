---
/**
 * Landing page of the TypeScript API reference. The pages under it are
 * generated by starlight-typedoc; this one replaces its plain module list with
 * modules grouped by topic, with a short description and what each exports.
 */
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';
import { getCollection } from 'astro:content';

interface Mod {
  id: string;
  title: string;
  description: string;
  /** Import path, if it is not pakdatakit/<id>. */
  from?: string;
}

const GROUPS: { title: string; intro: string; modules: Mod[] }[] = [
  {
    title: 'Identity and contact',
    intro: 'Check and format the numbers people type into sign-up and KYC forms.',
    modules: [
      { id: 'cnic', title: 'CNIC', description: 'Validate and format CNIC numbers; read the province and gender they encode.' },
      { id: 'phone', title: 'Phone', description: 'Validate, format and analyse mobile numbers in every common way they are written.' },
      { id: 'networks', title: 'Networks', description: 'Find the mobile network (Jazz, Zong, Telenor, Ufone…) from a number prefix.' },
      { id: 'numbers', title: 'Landlines and number types', description: 'Tell mobile, landline, toll-free and UAN numbers apart; look up area codes.' },
      { id: 'whatsapp', title: 'WhatsApp', description: 'Build wa.me links with an optional pre-filled message.' },
      { id: 'passport', title: 'Passport', description: 'Check the format of a Pakistani passport number.' },
      { id: 'input', title: 'As-you-type input', description: 'Format CNIC, phone and IBAN fields while the user types, and say what is missing.' },
    ],
  },
  {
    title: 'Banking and payments',
    intro: 'Bank accounts, Raast QR codes and utility bills.',
    modules: [
      { id: 'iban', title: 'IBAN and banks', description: 'Validate IBANs (with the check digits) and find the bank they belong to.' },
      { id: 'raast', title: 'Raast QR', description: 'Create and read Raast person-to-person and merchant QR payloads.' },
      { id: 'bills', title: 'Utility bills', description: 'Parse electricity reference numbers and check gas consumer numbers.' },
    ],
  },
  {
    title: 'Tax and invoicing',
    intro: 'Sales tax, income tax on salaries, NTN and FBR digital invoices.',
    modules: [
      { id: 'salestax', title: 'Sales tax', description: 'Federal and provincial sales tax rates by date; add tax or split it out.' },
      { id: 'incometax', title: 'Income tax on salary', description: 'Annual and monthly tax on salaries under each Finance Act.' },
      { id: 'tax', title: 'NTN and STRN', description: 'Validate and analyse NTN and STRN numbers.' },
      { id: 'fbr-invoice', title: 'FBR digital invoicing', description: 'Build and check invoices for the FBR digital invoicing API.' },
    ],
  },
  {
    title: 'Places and addresses',
    intro: 'Provinces, districts, cities, postal codes, couriers and vehicle plates.',
    modules: [
      { id: 'geo', title: 'Provinces, districts and cities', description: 'Search cities and districts; get divisions, tehsils and provinces.' },
      { id: 'postal', title: 'Postal codes', description: 'Postal codes for cities and post offices, and the reverse.' },
      { id: 'address', title: 'Addresses', description: 'Parse a free-text address into parts and format it back.' },
      { id: 'courier', title: 'Couriers', description: 'Map courier tracking statuses to one set; match city names to each courier.' },
      { id: 'vehicle', title: 'Vehicle plates', description: 'Parse and validate vehicle registration plates.' },
    ],
  },
  {
    title: 'Text, numbers and dates',
    intro: 'Urdu text, amounts in words, rupee formatting and the Hijri calendar.',
    modules: [
      { id: 'text', title: 'Urdu and Roman Urdu text', description: 'Normalise text, convert digits, slugify, compare Urdu and handle right-to-left.' },
      { id: 'words', title: 'Amounts in words', description: 'Write numbers and rupee amounts in words (lakh and crore).' },
      { id: 'format', title: 'Rupee formatting', description: 'Format amounts as PKR with lakh and crore grouping.' },
      { id: 'hijri', title: 'Hijri calendar', description: 'Convert to and from Hijri dates; month names and Ramadan.' },
      { id: 'holidays', title: 'Public holidays', description: 'Pakistan’s public holidays for a year or a date.' },
    ],
  },
  {
    title: 'Data quality',
    intro: 'Score the data you already have, and see which data version you ship.',
    modules: [
      { id: 'quality', title: 'Address and phone checks', description: 'Score how complete an address is; spot risky phone numbers.' },
      { id: 'data-version', title: 'Data version', description: 'The date of the bundled datasets, the same in every port.', from: 'pakdatakit' },
    ],
  },
  {
    title: 'Schema adapters',
    intro: 'The validators as ready-made rules for your schema library. Import from pakdatakit/<library>.',
    modules: [
      { id: 'adapters/zod', title: 'Zod', description: 'Zod schemas for CNIC, phone, IBAN and more.' },
      { id: 'adapters/valibot', title: 'Valibot', description: 'Valibot actions for the same checks.' },
      { id: 'adapters/yup', title: 'Yup', description: 'Yup tests for the same checks.' },
      { id: 'adapters/joi', title: 'Joi', description: 'A Joi extension with the same checks.' },
      { id: 'adapters/superstruct', title: 'Superstruct', description: 'Superstruct refinements for the same checks.' },
      { id: 'adapters/class-validator', title: 'class-validator', description: 'Decorators for class-validator.' },
    ],
  },
];

// What each module exports, counted from the generated pages.
const KINDS: Record<string, [string, string]> = {
  functions: ['function', 'functions'],
  interfaces: ['interface', 'interfaces'],
  'type-aliases': ['type', 'types'],
  variables: ['constant', 'constants'],
  classes: ['class', 'classes'],
  enumerations: ['enum', 'enums'],
};
const pages = await getCollection('docs', (e) => e.id.startsWith('api/typescript/'));
function counts(mod: string): string {
  const n: Record<string, number> = {};
  for (const p of pages) {
    const rest = p.id.slice(`api/typescript/${mod}/`.length);
    if (!p.id.startsWith(`api/typescript/${mod}/`)) continue;
    const kind = rest.split('/')[0];
    if (kind && KINDS[kind] && rest.includes('/')) n[kind] = (n[kind] ?? 0) + 1;
  }
  return Object.keys(KINDS)
    .filter((k) => n[k])
    .map((k) => `${n[k]} ${n[k] === 1 ? KINDS[k][0] : KINDS[k][1]}`)
    .join(' · ');
}

// Fail the build if a module is added to typedoc.json but not to this page.
const listed = new Set(GROUPS.flatMap((g) => g.modules.map((m) => m.id)));
const generated = new Set(
  pages
    .map((p) => p.id.slice('api/typescript/'.length))
    .filter((id) => id && !/(^|\/)(functions|interfaces|type-aliases|variables|classes|enumerations)(\/|$)/.test(id))
    .filter((id) => id !== 'index' && id !== ''),
);
const unlisted = [...generated].filter((id) => !listed.has(id) && ![...listed].some((l) => id.startsWith(`${l}/`)));
if (unlisted.length) throw new Error(`api/typescript/index.astro: add these modules to GROUPS: ${unlisted.join(', ')}`);

const total = pages.filter((p) => p.id.includes('/functions/')).length;
const example = `import { validateCNIC, formatPhone } from 'pakdatakit';

validateCNIC('42101-1234567-1'); // true
formatPhone('03001234567');      // '+923001234567'`;
---

<StarlightPage
  frontmatter={{
    title: 'TypeScript API reference',
    description: `Every function, type and option in pakdatakit for TypeScript and JavaScript: ${total} functions in ${listed.size} modules, generated from the source.`,
    tableOfContents: false,
  }}
>
  <p class="lead">
    Every function, type and option in the <code>pakdatakit</code> npm package, generated from its source and doc
    comments. {total} functions in {listed.size} modules. Everything is exported from <code>pakdatakit</code>; each module
    is also its own entry point (for example <code>pakdatakit/cnic</code>) if you want to import less.
  </p>

  <Code code={example} lang="ts" title="Quick start" />

  <p class="hint">
    Looking for a function by name? Press <kbd>/</kbd> or <kbd>Ctrl</kbd>&nbsp;<kbd>K</kbd> to search. New here? Start with the{' '}
    <a href="/install/typescript/">install guide</a> or the{' '}
    <a href="/docs/cnic/">module guides</a>, which have examples in all five languages.
  </p>

  {
    GROUPS.map((group) => (
      <section class="api-group">
        <h2 id={group.title.toLowerCase().replace(/[^a-z]+/g, '-')}>{group.title}</h2>
        <p class="api-intro">{group.intro}</p>
        <ul class="api-grid not-content" role="list">
          {group.modules.map((m) => (
            <li>
              <a class="api-card" href={`/api/typescript/${m.id}/`}>
                <span class="api-title">{m.title}</span>
                <code class="api-path">{m.from ?? `pakdatakit/${m.id.replace('adapters/', '')}`}</code>
                <span class="api-desc">{m.description}</span>
                <span class="api-counts">{counts(m.id)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</StarlightPage>

<style>
  .lead {
    font-size: var(--sl-text-lg);
    color: var(--sl-color-gray-2);
  }
  .hint {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  kbd {
    font-family: var(--sl-font-mono);
    font-size: 0.8em;
    border: 1px solid var(--sl-color-gray-5);
    border-bottom-width: 2px;
    border-radius: 0.3rem;
    padding: 0 0.35em;
  }
  .api-group {
    margin-top: 2.5rem;
  }
  .api-intro {
    color: var(--sl-color-gray-3);
  }
  .api-grid {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }
  .api-card {
    display: grid;
    gap: 0.3rem;
    height: 100%;
    padding: 0.9rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--pdk-surface);
    color: var(--sl-color-gray-2);
    text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .api-card:hover {
    border-color: var(--sl-color-accent);
  }
  .api-card:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .api-title {
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .api-path {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-accent-high);
    background: none;
    padding: 0;
    border: 0;
  }
  :global(:root[data-theme='light']) .api-path {
    color: var(--sl-color-accent);
  }
  .api-desc {
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }
  .api-counts {
    margin-top: 0.25rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  @media (prefers-reduced-motion: no-preference) {
    .api-card:hover {
      transform: translateY(-1px);
    }
  }
</style>
