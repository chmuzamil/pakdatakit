---
import ToolPage from '../../components/ToolPage.astro';
import IbanTool from '../../components/tools/IbanTool.tsx';
---

<ToolPage
  title="Pakistan IBAN checker and bank lookup"
  description="Check a Pakistani IBAN's length and check digits (mod-97) and find its bank. Runs in your browser; it does not confirm the account exists."
