---
import { dataVersion } from 'pakdatakit';
import ToolPage from '../../components/ToolPage.astro';
import SalaryTaxTool from '../../components/tools/SalaryTaxTool.tsx';
---

<ToolPage
  title="Salary tax calculator 2026-27 (tax year 2027)"
  description="Monthly and annual income tax on salary from the Finance Act 2026 salaried rates (tax year 2027), with every slab shown and the law cited. Earlier years from 2020 too."
  appName="Pakistan salary tax calculator"
  path="/tools/salary-tax/"
>
  <SalaryTaxTool client:load dataChecked={dataVersion} />
</ToolPage>
