{
  "$schema": "https://typedoc.org/schema.json",
  "name": "PakDataKit",
  "entryPoints": [
    "src/cnic.ts",
    "src/phone.ts",
    "src/networks.ts",
    "src/numbers.ts",
    "src/whatsapp.ts",
    "src/iban.ts",
    "src/raast.ts",
    "src/tax.ts",
    "src/input.ts",
    "src/postal.ts",
    "src/geo.ts",
    "src/address.ts",
    "src/text.ts",
    "src/words.ts",
    "src/format.ts",
    "src/hijri.ts",
    "src/holidays.ts",
    "src/passport.ts",
    "src/vehicle.ts",
    "src/salestax.ts",
    "src/incometax.ts",
    "src/fbr-invoice.ts",
    "src/bills.ts",
    "src/courier.ts",
    "src/quality.ts",
    "src/withholding.ts",
    "src/zakat.ts",
    "src/population.ts",
    "src/data-info.ts",
    "src/data-version.ts",
    "src/adapters/zod.ts",
    "src/adapters/valibot.ts",
    "src/adapters/yup.ts",
    "src/adapters/joi.ts",
    "src/adapters/superstruct.ts",
    "src/adapters/class-validator.ts"
  ],
  "entryPointStrategy": "resolve",
  "out": "docs-site",
  "plugin": ["./scripts/typedoc-social.mjs"],
  "readme": "README.md",
  "projectDocuments": ["DATA.md", "CHANGELOG.md", "SECURITY.md"],
  "includeVersion": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "sort": ["source-order"],
  "navigationLinks": {
    "GitHub": "https://github.com/chmuzamil/pakdatakit",
    "npm": "https://www.npmjs.com/package/pakdatakit",
    "Playground": "https://pakdatakit.dev/playground/"
  },
  "hostedBaseUrl": "https://chmuzamil.github.io/pakdatakit/",
  "useHostedBaseUrlForAbsoluteLinks": false,
  "treatWarningsAsErrors": false,
  "highlightLanguages": [
    "bash",
    "console",
    "css",
    "html",
    "javascript",
    "json",
    "jsonc",
    "json5",
    "yaml",
    "tsx",
    "typescript",
    "python",
    "dart",
    "csharp",
    "php",
    "vue"
  ]
}
