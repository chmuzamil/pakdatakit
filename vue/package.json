{
  "name": "pakdatakit-vue",
  "version": "0.1.1",
  "description": "Vue composables, a directive and ready-made checkout and KYC forms for Pakistani CNIC, mobile numbers, IBANs and addresses, built on pakdatakit",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "pakistan",
    "vue",
    "vue3",
    "cnic",
    "phone",
    "mobile",
    "iban",
    "input",
    "input-mask",
    "form",
    "composables",
    "directive",
    "pakdatakit",
    "address",
    "checkout",
    "kyc",
    "urdu"
  ],
  "author": "Muzamil Chaudhery",
  "license": "MIT",
  "homepage": "https://pakdatakit.dev/install/vue/",
  "bugs": {
    "url": "https://github.com/chmuzamil/pakdatakit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chmuzamil/pakdatakit.git",
    "directory": "vue"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "pakdatakit": "^2.5.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.10",
    "@vue/test-utils": "^2.5.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "pakdatakit": "file:..",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "vue": "^3.5.45"
  }
}
